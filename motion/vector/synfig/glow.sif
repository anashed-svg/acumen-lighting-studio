<?xml version="1.0" encoding="UTF-8"?>
<!-- Acumen "light on" sting: a warm light blooms, the logo appears in it with radial light streaks,
     an LED line runs under it, then EN + AR taglines. 1280x720, 24 fps, 4 s. 1 unit = 80 px.
     Brand values are exported in <defs> (Synfig Studio → Library panel); render_synfig.py rewrites them. -->
<canvas version="1.2" width="1280" height="720" xres="2834.645669" yres="2834.645669"
        gamma-r="1.0" gamma-g="1.0" gamma-b="1.0" view-box="-8 4.5 8 -4.5" antialias="1"
        fps="24" begin-time="0f" end-time="95f" bgcolor="0.02 0.02 0.02 1">
  <name>Acumen light on</name>
  <defs>
    <color id="bg"><r>0.019608</r><g>0.019608</g><b>0.019608</b><a>1</a></color>
    <color id="ink"><r>0.956863</r><g>0.945098</g><b>0.917647</b><a>1</a></color>
    <color id="glow"><r>1.000000</r><g>0.768627</g><b>0.470588</b><a>1</a></color>
    <gradient id="falloff">
      <color pos="0.00"><r>1.000000</r><g>0.768627</g><b>0.470588</b><a>1.00</a></color>
      <color pos="0.18"><r>1.000000</r><g>0.768627</g><b>0.470588</b><a>0.55</a></color>
      <color pos="0.45"><r>1.000000</r><g>0.768627</g><b>0.470588</b><a>0.16</a></color>
      <color pos="0.75"><r>1.000000</r><g>0.768627</g><b>0.470588</b><a>0.03</a></color>
      <color pos="1.00"><r>1.000000</r><g>0.768627</g><b>0.470588</b><a>0.00</a></color>
    </gradient>
    <string id="logo">../../../video/public/logo-white.png</string>
    <vector id="logo_tl"><x>-1.75</x><y>2.35</y></vector>
    <vector id="logo_br"><x>1.75</x><y>-1.15</y></vector>
    <vector id="logo_center"><x>0</x><y>0.6</y></vector>
    <string id="font_latin">/usr/local/share/fonts/google/Poppins/Poppins-200.ttf</string>
    <string id="font_arabic">/usr/local/share/fonts/google/NotoKufiArabic/NotoKufiArabic-300.ttf</string>
    <string id="tagline_en">C R A F T I N G   T H E   A T M O S P H E R E</string>
    <string id="tagline_ar">نصنع الأجواء</string>
    <animated type="real" id="push">  <!-- slow push-in of the logo: zoom = e^amount -->
      <waypoint time="0.8s" before="clamped" after="clamped"><real value="-0.06"/></waypoint>
      <waypoint time="4s" before="clamped" after="clamped"><real value="0.02"/></waypoint>
    </animated>
  </defs>

  <layer type="rectangle" desc="background">
    <param name="color" use="bg"/>
    <param name="point1"><vector><x>-9</x><y>5</y></vector></param>
    <param name="point2"><vector><x>9</x><y>-5</y></vector></param>
  </layer>

  <!-- the light: wide soft halo + hot core, both grow from a point, then breathe -->
  <layer type="radial_gradient" desc="halo">
    <param name="gradient" use="falloff"/>
    <param name="center" use="logo_center"/>
    <param name="amount">
      <animated type="real">
        <waypoint time="0s" before="clamped" after="clamped"><real value="0"/></waypoint>
        <waypoint time="1.2s" before="clamped" after="clamped"><real value="0.6"/></waypoint>
        <waypoint time="2.4s" before="clamped" after="clamped"><real value="0.42"/></waypoint>
        <waypoint time="3.4s" before="clamped" after="clamped"><real value="0.55"/></waypoint>
      </animated>
    </param>
    <param name="radius">
      <animated type="real">
        <waypoint time="0s" before="clamped" after="clamped"><real value="0.01"/></waypoint>
        <waypoint time="1.4s" before="clamped" after="clamped"><real value="7.5"/></waypoint>
        <waypoint time="4s" before="clamped" after="clamped"><real value="8.2"/></waypoint>
      </animated>
    </param>
  </layer>
  <layer type="radial_gradient" desc="core">
    <param name="gradient" use="falloff"/>
    <param name="center" use="logo_center"/>
    <param name="amount">
      <animated type="real">
        <waypoint time="0s" before="clamped" after="clamped"><real value="0"/></waypoint>
        <waypoint time="0.5s" before="clamped" after="clamped"><real value="1"/></waypoint>
        <waypoint time="1.6s" before="clamped" after="clamped"><real value="0.45"/></waypoint>
      </animated>
    </param>
    <param name="radius">
      <animated type="real">
        <waypoint time="0s" before="clamped" after="clamped"><real value="0.01"/></waypoint>
        <waypoint time="1.2s" before="clamped" after="clamped"><real value="2.2"/></waypoint>
      </animated>
    </param>
  </layer>

  <!-- logo light streaks: the logo, radially blurred from the light centre, added on top -->
  <layer type="group" desc="logo streaks">
    <param name="blend_method"><integer value="4"/></param>
    <param name="amount">
      <animated type="real">
        <waypoint time="0.8s" before="clamped" after="clamped"><real value="0"/></waypoint>
        <waypoint time="1.8s" before="clamped" after="clamped"><real value="0.55"/></waypoint>
        <waypoint time="4s" before="clamped" after="clamped"><real value="0.3"/></waypoint>
      </animated>
    </param>
    <param name="canvas">
      <canvas>
        <layer type="import" desc="logo">
          <param name="tl" use="logo_tl"/>
          <param name="br" use="logo_br"/>
          <param name="filename" use="logo"/>
        </layer>
        <layer type="zoom" desc="push-in">
          <param name="center" use="logo_center"/>
          <param name="amount" use="push"/>
        </layer>
        <layer type="radial_blur" desc="streaks">
          <param name="origin" use="logo_center"/>
          <param name="size"><real value="0.6"/></param>
          <param name="fade_out"><bool value="true"/></param>
        </layer>
      </canvas>
    </param>
  </layer>

  <layer type="group" desc="logo">
    <param name="amount">
      <animated type="real">
        <waypoint time="0.8s" before="clamped" after="clamped"><real value="0"/></waypoint>
        <waypoint time="1.8s" before="clamped" after="clamped"><real value="1"/></waypoint>
      </animated>
    </param>
    <param name="canvas">
      <canvas>
        <layer type="import" desc="logo">
          <param name="tl" use="logo_tl"/>
          <param name="br" use="logo_br"/>
          <param name="filename" use="logo"/>
        </layer>
        <layer type="zoom" desc="push-in">
          <param name="center" use="logo_center"/>
          <param name="amount" use="push"/>
        </layer>
      </canvas>
    </param>
  </layer>

  <!-- LED line: glow pass (blurred, added) + crisp core, both grow out from the centre -->
  <layer type="group" desc="led line">
    <param name="canvas">
      <canvas>
        <layer type="group" desc="led glow">
          <param name="blend_method"><integer value="4"/></param>
          <param name="amount"><real value="0.8"/></param>
          <param name="canvas">
            <canvas>
              <layer type="rectangle" desc="led bar">
                <param name="color" use="glow"/>
                <param name="point1">
                  <animated type="vector">
                    <waypoint time="1.6s" before="clamped" after="clamped"><vector><x>0</x><y>-1.49</y></vector></waypoint>
                    <waypoint time="2.5s" before="clamped" after="clamped"><vector><x>-1.4</x><y>-1.49</y></vector></waypoint>
                  </animated>
                </param>
                <param name="point2">
                  <animated type="vector">
                    <waypoint time="1.6s" before="clamped" after="clamped"><vector><x>0</x><y>-1.53</y></vector></waypoint>
                    <waypoint time="2.5s" before="clamped" after="clamped"><vector><x>1.4</x><y>-1.53</y></vector></waypoint>
                  </animated>
                </param>
              </layer>
              <layer type="blur" desc="bloom">
                <param name="size"><vector><x>0.12</x><y>0.12</y></vector></param>
                <param name="type"><integer value="3"/></param>
              </layer>
            </canvas>
          </param>
        </layer>
        <layer type="rectangle" desc="led core">
          <param name="color" use="ink"/>
          <param name="point1">
            <animated type="vector">
              <waypoint time="1.6s" before="clamped" after="clamped"><vector><x>0</x><y>-1.5</y></vector></waypoint>
              <waypoint time="2.5s" before="clamped" after="clamped"><vector><x>-1.4</x><y>-1.5</y></vector></waypoint>
            </animated>
          </param>
          <param name="point2">
            <animated type="vector">
              <waypoint time="1.6s" before="clamped" after="clamped"><vector><x>0</x><y>-1.52</y></vector></waypoint>
              <waypoint time="2.5s" before="clamped" after="clamped"><vector><x>1.4</x><y>-1.52</y></vector></waypoint>
            </animated>
          </param>
        </layer>
      </canvas>
    </param>
  </layer>

  <!-- taglines. Letter-spacing = one space between letters (the "compress" param spaces glyphs unevenly);
       never space Arabic, it breaks the joins. -->
  <layer type="text" desc="tagline en">
    <param name="text" use="tagline_en"/>
    <param name="color" use="ink"/>
    <param name="family" use="font_latin"/>
    <param name="size"><vector><x>0.17</x><y>0.17</y></vector></param>
    <param name="use_kerning"><bool value="false"/></param>
    <param name="orient"><vector><x>0.5</x><y>0.5</y></vector></param>
    <param name="grid_fit"><bool value="false"/></param>
    <param name="amount">
      <animated type="real">
        <waypoint time="2.2s" before="clamped" after="clamped"><real value="0"/></waypoint>
        <waypoint time="3s" before="clamped" after="clamped"><real value="1"/></waypoint>
      </animated>
    </param>
    <param name="origin">
      <animated type="vector">
        <waypoint time="2.2s" before="clamped" after="clamped"><vector><x>0</x><y>-2.2</y></vector></waypoint>
        <waypoint time="3s" before="clamped" after="clamped"><vector><x>0</x><y>-2.08</y></vector></waypoint>
      </animated>
    </param>
  </layer>
  <layer type="text" desc="tagline ar">
    <param name="text" use="tagline_ar"/>
    <param name="color" use="ink"/>
    <param name="family" use="font_arabic"/>
    <param name="size"><vector><x>0.26</x><y>0.26</y></vector></param>
    <param name="orient"><vector><x>0.5</x><y>0.5</y></vector></param>
    <param name="grid_fit"><bool value="false"/></param>
    <param name="amount">
      <animated type="real">
        <waypoint time="2.6s" before="clamped" after="clamped"><real value="0"/></waypoint>
        <waypoint time="3.4s" before="clamped" after="clamped"><real value="0.75"/></waypoint>
      </animated>
    </param>
    <param name="origin">
      <animated type="vector">
        <waypoint time="2.6s" before="clamped" after="clamped"><vector><x>0</x><y>-2.98</y></vector></waypoint>
        <waypoint time="3.4s" before="clamped" after="clamped"><vector><x>0</x><y>-2.86</y></vector></waypoint>
      </animated>
    </param>
  </layer>
</canvas>
