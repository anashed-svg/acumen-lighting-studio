# مزوّد الصور: openai (الافتراضي) أو gemini
IMAGE_PROVIDER=openai

# مفتاح OpenAI (sk-...) — مطلوب لتطبيق الويب
OPENAI_API_KEY=

# مفتاح Gemini (اختياري — فقط لو IMAGE_PROVIDER=gemini، أو للبوت)
GEMINI_API_KEY=

# توكن بوت تيليجرام (اختياري — فقط للبوت)
TELEGRAM_BOT_TOKEN=

# (اختياري) إعدادات جودة OpenAI
# OPENAI_IMAGE_QUALITY=high      # low | medium | high
# OPENAI_INPUT_FIDELITY=high     # high يحافظ على شكل المبنى
# OPENAI_IMAGE_SIZE=auto         # auto | 1024x1024 | 1536x1024 | 1024x1536

# --- Video tools (see video/README.md) ---
# ELEVENLABS_API_KEY=            # voice-over
# REPLICATE_API_TOKEN=           # Kling / Luma / Runway via Replicate
# FAL_KEY=                       # same models via fal.ai
